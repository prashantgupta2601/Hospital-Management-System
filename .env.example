# ─────────────────────────────────────────────────────────────
# PG CARE — Hospital Management System
# Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────
POSTGRES_DB=hms
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_strong_password

DATABASE_URL=jdbc:postgresql://postgres:5432/hms
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=changeme_strong_password

# ── JWT ──────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=replace_with_64_hex_char_random_secret_key_generated_via_openssl
JWT_EXPIRATION_MS=86400000

# ── Backend Server ───────────────────────────────────────────
SERVER_PORT=8081

# ── Spring Profile ───────────────────────────────────────────
# Options: dev | prod
SPRING_PROFILES_ACTIVE=prod

# ── CORS Allowed Origins ─────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80
